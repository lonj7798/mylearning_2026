.DS_Store
.jaewon-learning/sessions/*.tmp
.jaewon-learning/cache/
*.swp
*.swo

# editor config (personal)
.vscode/

# source material clones — not tracked on learning repo
/boson-agent/
/jaewon-plugin-learning-dev/

# automation-bench: raw clone of github.com/zapier/AutomationBench is local-only
# study material (re-clone with: git clone --depth 1 <url> wiki/raw-data/automation-bench).
# Ignore the raw repo (and its nested .git); track only the curated library files.
/wiki/raw-data/automation-bench/*
!/wiki/raw-data/automation-bench/LIBRARY.md
!/wiki/raw-data/automation-bench/COLLECTION-PLAN.md
!/wiki/raw-data/automation-bench/insights.md
!/wiki/raw-data/automation-bench/excerpts/

# pipecat: raw clone of github.com/pipecat-ai/pipecat is local-only study
# material (re-clone with:
#   git clone --depth 1 https://github.com/pipecat-ai/pipecat.git \
#     wiki/raw-data/pipecat/pipecat-src
# ). Ignore the raw repo (and its nested .git); track only the curated library.
/wiki/raw-data/pipecat/pipecat-src/

# transient agent/session state
.omc/state/
.omc/sessions/
.omc/project-memory.json
.omc/logs/
.jaewon/context/
.jaewon/session-log.md
